# ---------------------------------------------------------------------------
# Local development environment. Copy to `.env` and adjust.
# NEVER commit a real `.env` - it is git-ignored.
# ---------------------------------------------------------------------------

# --- Postgres ---------------------------------------------------------------
POSTGRES_DB=wfe
POSTGRES_USER=wfe
POSTGRES_PASSWORD=wfe_dev_pwd
# Set to 5433 when a local Postgres service already owns 5432 (Windows default).
POSTGRES_PORT=5432

# --- Kafka (KRaft, single node) --------------------------------------------
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=wfe-kraft-01

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=wfe
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pwd
KEYCLOAK_REALM=wfe

# --- Backend ----------------------------------------------------------------
# Public issuer URI the SPA and the API use. Inside docker-compose network use
# the service name (`http://keycloak:8080`); from the host use
# `http://localhost:8081`.
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/wfe
WFE_JWT_ISSUER_URI=http://keycloak:8080/realms/wfe
WFE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---------------------------------------------------------------
# The API listens on 8082 on this host (8080 is the HealthNexus "ClinicFlow"
# stack). VITE_API_BASE_URL is the direct API base for the SPA; the dev server
# proxies /api to 8082 via VITE_API_TARGET in frontend/.env.local.
VITE_API_BASE_URL=http://localhost:8082/api
VITE_SSE_URL=http://localhost:8082/api/stream
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=wfe
VITE_KEYCLOAK_CLIENT_ID=wfe-frontend

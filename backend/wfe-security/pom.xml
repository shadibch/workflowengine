<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.wfe</groupId>
    <artifactId>wfe-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>wfe-security</artifactId>
  <name>wfe-security</name>
  <description>
    OIDC resource-server validation (Keycloak-compatible JWKS), the tenant
    resolver, and the DB-authoritative role/assignment lookup that backs the
    hybrid identity model: JWT authenticates, Postgres authorizes.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.wfe</groupId>
      <artifactId>wfe-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.wfe</groupId>
      <artifactId>wfe-persistence</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- The filter chain is servlet-based, so the servlet API is a compile-time
         requirement of this module. wfe-app supplies the runtime container. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.wfe</groupId>
  <artifactId>wfe-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>wfe-parent</name>
  <description>BPMN 2.0 workflow engine - backend</description>

  <modules>
    <module>wfe-bom</module>
    <module>wfe-core</module>
    <module>wfe-persistence</module>
    <module>wfe-integration</module>
    <module>wfe-security</module>
    <module>wfe-app</module>
  </modules>

  <properties>
    <!--
      Target Java 21 (LTS) even when building with a newer JDK: javac is invoked
      with a release flag of 21, so the produced bytecode targets 21 and a JDK
      21 toolchain is optional. Spring Boot 3.4 requires 17+; 21 is the
      supported LTS baseline.
    -->
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependency versions not managed by the Spring Boot BOM. -->
    <graaljs.version>24.1.2</graaljs.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.wfe</groupId>
        <artifactId>wfe-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.wfe</groupId>
        <artifactId>wfe-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.wfe</groupId>
        <artifactId>wfe-integration</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.wfe</groupId>
        <artifactId>wfe-security</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution>
              <id>enforce-toolchain</id>
              <goals><goal>enforce</goal></goals>
              <configuration>
                <rules>
                  <requireJavaVersion>
                    <version>[21,)</version>
                    <message>JDK 21 or newer is required (set JAVA_HOME).</message>
                  </requireJavaVersion>
                  <requireMavenVersion>
                    <version>[3.9,)</version>
                  </requireMavenVersion>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Deterministic timezone/locale so expression and calendar tests
                 behave identically on every developer machine and CI runner. -->
            <argLine>-Duser.timezone=UTC -Duser.language=en -Duser.country=US -Dfile.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <argLine>-Duser.timezone=UTC -Dfile.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

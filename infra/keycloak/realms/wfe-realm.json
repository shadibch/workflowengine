{
  "realm": "wfe",
  "enabled": true,
  "displayName": "Workflow Engine",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "defaultSignatureAlgorithm": "RS256",

  "clients": [
    {
      "clientId": "wfe-frontend",
      "name": "Workflow Engine frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5173"
      ],
      "webOrigins": ["http://localhost:5173"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "frontchannelLogout": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    },
    {
      "clientId": "wfe-api",
      "name": "Workflow Engine backend resource server",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "serviceAccountsEnabled": false
    }
  ],

  "roles": {
    "realm": [
      { "name": "admin",     "description": "Full access including identity, connections and audit" },
      { "name": "designer",  "description": "May author, validate, publish and simulate workflow definitions" },
      { "name": "operations","description": "Starts instances and administers running ones" },
      { "name": "reviewer",  "description": "Candidate group for review user tasks" },
      { "name": "viewer",    "description": "Read-only access to definitions, instances and dashboards" }
    ]
  },

  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@wfe.local",
      "firstName": "WFE",
      "lastName": "Administrator",
      "emailVerified": true,
      "realmRoles": ["admin"],

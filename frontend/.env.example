# Copy to .env.local and adjust. The OIDC authority derives from these values.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=wfe
VITE_KEYCLOAK_CLIENT_ID=wfe-frontend
# Backend target for the Vite dev proxy (defaults to http://localhost:8082;
# 8080 is taken by the HealthNexus "ClinicFlow" stack on this developer host).
VITE_API_TARGET=http://localhost:8082